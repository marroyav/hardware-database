    fd2_vd_ci_gas_array [label="Gas Array", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.gas_array", target="_top", tooltip="Open Gas Array in the interactive explorer", shape="ellipse", style="filled", fillcolor="#f7dde0", color="#a14656", fontcolor="#4a1823"];
    fd2_vd_ci_t2_bundle [label="T2 Cable Bundle", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.t2_bundle", target="_top", tooltip="Open T2 Cable Bundle in the interactive explorer", shape="hexagon", style="filled", fillcolor="#fff0cc", color="#a56b17", fontcolor="#4f370c"];
    fd2_vd_ci_t4_bundle [label="T4 Cable Bundle", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.t4_bundle", target="_top", tooltip="Open T4 Cable Bundle in the interactive explorer", shape="hexagon", style="filled", fillcolor="#fff0cc", color="#a56b17", fontcolor="#4f370c"];
