digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#071421",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Detector Overview · Dependencies",
    labelloc="t",
    labeljust="l",
    fontname="Avenir Next",
    fontsize=26,
    fontcolor="#edf8ff"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#6ecbe8", fontcolor="#bdefff"];

  fd2_vd_overview [label="FD2-VD Detector Overview", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview", target="_top", tooltip="Open FD2-VD Detector Overview in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#08243a", color="#58c7e8", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="2.0"];

  fd2_vd_overview_vd_bde [label="BDE", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_bde", target="_top", tooltip="Open BDE in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  fd2_vd_overview_vd_daq [label="DAQ", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_daq", target="_top", tooltip="Open DAQ in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  fd2_vd_overview_vd_field_cage [label="Field Cage", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_field_cage", target="_top", tooltip="Open Field Cage in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9edf7", color="#4c8fb0", fontcolor="#0d2b3d"];
  fd2_vd_overview_vd_hv_cathode [label="HV Cathode", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_hv_cathode", target="_top", tooltip="Open HV Cathode in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9edf7", color="#4c8fb0", fontcolor="#0d2b3d"];
  fd2_vd_overview_vd_pds_cathode [label="PDS Cathode Modules", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_pds_cathode", target="_top", tooltip="Open PDS Cathode Modules in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  fd2_vd_overview_vd_pds_membrane [label="PDS Membrane Modules", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_pds_membrane", target="_top", tooltip="Open PDS Membrane Modules in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  fd2_vd_overview_vd_tde [label="TDE", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_tde", target="_top", tooltip="Open TDE in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  fd2_vd_overview_vd_crp [label="Top CRP", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_crp", target="_top", tooltip="Open Top CRP in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9edf7", color="#4c8fb0", fontcolor="#0d2b3d"];

  fd2_vd_overview_vd_crp -> fd2_vd_overview_vd_tde [URL="../explorer.html#object=relation%3A38", target="_top", tooltip="Open interfaces with relation in the interactive explorer", color="#40c7f0", fontcolor="#9ee8ff", style="dashed", penwidth="1.2", label="interface"];
