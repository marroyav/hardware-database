digraph DetectorPlate {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#f4efe6",
    pad="0.45",
    nodesep="0.42",
    ranksep="0.78",
    label="FD2-VD · Dense System Plate",
    labelloc="t",
    labeljust="l",
    fontname="Iowan Old Style",
    fontsize=30,
    fontcolor="#183247"
  ];
  node [fontname="Avenir Next", fontsize=11, margin="0.16,0.11", penwidth=1.2];
  edge [fontname="Avenir Next", fontsize=9, arrowsize=0.74, penwidth=1.1, color="#33536a", fontcolor="#33536a"];

  subgraph cluster_context {
    label="FD2-VD Context";
    style="rounded,filled";
    color="#b79d7c";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=14;
    fontcolor="#5a4634";
    context_fd2_vd_bde [label="BDE", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    context_fd2_vd_daq [label="DAQ", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    context_fd2_vd_detector [label="FD2-VD Complete Detector", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#183247", color="#183247", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="1.5"];
    context_fd2_vd_field_cage [label="Field Cage", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
    context_fd2_vd_pds_cathode [label="PDS Cathode Modules", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    context_fd2_vd_pds_membrane [label="PDS Membrane Modules", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    context_fd2_vd_superstructure [label="Superstructure (SST)", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_ci {
    label="FD2-VD Cryogenic Instrumentation";
    style="rounded,filled";
    color="#b59f86";
    fillcolor="#fffaf2";
    penwidth=1.2;
    fontname="Avenir Next";
    fontsize=15;
    fontcolor="#4f3f31";
