digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#f6f1e8",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Detector Overview · Hierarchy",
    labelloc="t",
    labeljust="l",
    fontname="Iowan Old Style",
    fontsize=26,
    fontcolor="#183247"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#33536a", fontcolor="#33536a"];

  fd2_vd_overview [label="FD2-VD Detector Overview", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview", target="_top", tooltip="Open FD2-VD Detector Overview in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#183247", color="#183247", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="1.5"];

  fd2_vd_overview_vd_ci [label="Cryogenic Instrumentation", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_ci", target="_top", tooltip="Open Cryogenic Instrumentation in the interactive explorer", shape="ellipse", style="filled", fillcolor="#f7dde0", color="#a14656", fontcolor="#4a1823"];
  fd2_vd_overview_vd_daq [label="DAQ", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_daq", target="_top", tooltip="Open DAQ in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  fd2_vd_overview_fd2_vd_detector [label="FD2-VD Complete Detector", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.fd2_vd_detector", target="_top", tooltip="Open FD2-VD Complete Detector in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  fd2_vd_overview_vd_field_cage [label="Field Cage", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_field_cage", target="_top", tooltip="Open Field Cage in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  fd2_vd_overview_vd_hv_cathode [label="HV Cathode", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_hv_cathode", target="_top", tooltip="Open HV Cathode in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  fd2_vd_overview_vd_pds_cathode [label="PDS Cathode Modules", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_overview.vd_pds_cathode", target="_top", tooltip="Open PDS Cathode Modules in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
