    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Top Vertical Drift CRP Electronics · Hierarchy",
    labelloc="t",
    labeljust="l",
    fontname="Iowan Old Style",
    fontsize=26,
    fontcolor="#183247"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#33536a", fontcolor="#33536a"];

  fd2_vd_tde [label="FD2-VD Top Vertical Drift CRP Electronics", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde", target="_top", tooltip="Open FD2-VD Top Vertical Drift CRP Electronics in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#183247", color="#183247", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="1.5"];

  subgraph cluster_fd2_vd_tde_analog_electronics {
