digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#f6f1e8",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Top Vertical Drift CRP Electronics · Hierarchy",
    labelloc="t",
    labeljust="l",
    fontname="Iowan Old Style",
    fontsize=26,
    fontcolor="#183247"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#33536a", fontcolor="#33536a"];

  fd2_vd_tde [label="FD2-VD Top Vertical Drift CRP Electronics", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#183247", color="#183247", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="1.5"];

  subgraph cluster_fd2_vd_tde_analog_electronics {
    label="Analog Electronics";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_tde_feb_analog_card [label="FEB Analog Card", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  subgraph cluster_fd2_vd_tde_digital_electronics {
    label="Digital Electronics";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_tde_amc_digitization_card [label="AMC Digitization Card", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    fd2_vd_tde_wr_mch_timing_end_node [label="WR-MCH Timing End-Node", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    fd2_vd_tde_utca_crate [label="uTCA Crate", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
    fd2_vd_tde_utca_mch [label="uTCA MCH", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    fd2_vd_tde_utca_pu [label="uTCA Power Unit", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  subgraph cluster_fd2_vd_tde_sgft_chimney {
    label="SGFT Chimney";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_tde_cold_flange [label="Cold Flange", fontname="Avenir Next", shape="parallelogram", style="filled", fillcolor="#f3e5cc", color="#9d6a14", fontcolor="#52360a"];
    fd2_vd_tde_sgft_chimney_assembly [label="SGFT Chimney", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
    fd2_vd_tde_warm_flange [label="Warm Flange", fontname="Avenir Next", shape="parallelogram", style="filled", fillcolor="#f3e5cc", color="#9d6a14", fontcolor="#52360a"];
  }

  subgraph cluster_fd2_vd_tde_shipping {
    label="Shipping Containers";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_tde_shipping_container [label="Shipping Container", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_tde_ancillary_systems {
    label="TDE Ancillary Systems";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_tde_lv_ps [label="Low-Voltage Power Supply", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  subgraph cluster_fd2_vd_tde_timing_distribution {
    label="Timing Distribution";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_tde_wr_switch [label="White Rabbit Switch", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  fd2_vd_tde -> fd2_vd_tde_sgft_chimney_assembly [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde -> fd2_vd_tde_utca_crate [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde -> fd2_vd_tde_wr_switch [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde -> fd2_vd_tde_lv_ps [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde -> fd2_vd_tde_shipping_container [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde_sgft_chimney_assembly -> fd2_vd_tde_cold_flange [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde_sgft_chimney_assembly -> fd2_vd_tde_warm_flange [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde_sgft_chimney_assembly -> fd2_vd_tde_feb_analog_card [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="24 or 48"];
  fd2_vd_tde_utca_crate -> fd2_vd_tde_amc_digitization_card [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="24 or 48 channels worth of AMC slots"];
  fd2_vd_tde_utca_crate -> fd2_vd_tde_utca_mch [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde_utca_crate -> fd2_vd_tde_utca_pu [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde_utca_crate -> fd2_vd_tde_wr_mch_timing_end_node [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde_shipping_container -> fd2_vd_tde_utca_crate [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_tde_shipping_container -> fd2_vd_tde_sgft_chimney_assembly [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
}
