    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_top_crp.half_crp";
    target="_top";
    tooltip="Open Half CRP / CRU in the interactive explorer";
    fd2_vd_top_crp_cru [label="Top Half CRP / CRU", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_top_crp.cru", target="_top", tooltip="Open Top Half CRP / CRU in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9edf7", color="#4c8fb0", fontcolor="#0d2b3d"];
  }

  subgraph cluster_fd2_vd_top_crp_complete_crp {
    label="Instrumented CRP / Complete CRP";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_top_crp.complete_crp";
    target="_top";
    tooltip="Open Instrumented CRP / Complete CRP in the interactive explorer";
    fd2_vd_top_crp_top_crp [label="Instrumented Top CRP", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_top_crp.top_crp", target="_top", tooltip="Open Instrumented Top CRP in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9edf7", color="#4c8fb0", fontcolor="#0d2b3d"];
  }

  fd2_vd_top_crp -> fd2_vd_top_crp_top_crp [URL="../explorer.html#object=relation%3A80", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4"];
  fd2_vd_top_crp_top_crp -> fd2_vd_top_crp_cru [URL="../explorer.html#object=relation%3A81", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4", label="2"];
