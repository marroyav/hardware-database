    target="_top";
    tooltip="Open Temperature Monitoring System in the interactive explorer";
    fd2_vd_ci_temperature_monitoring_system [label="Temperature Monitoring System", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.temperature_monitoring_system", target="_top", tooltip="Open Temperature Monitoring System in the interactive explorer", shape="ellipse", style="filled", fillcolor="#f7dde0", color="#a14656", fontcolor="#4a1823"];
