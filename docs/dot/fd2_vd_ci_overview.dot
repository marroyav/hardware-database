  fd2_vd_ci -> fd2_vd_ci_temperature_monitoring_system [URL="../explorer.html#object=relation%3A1", target="_top", tooltip="Open contains relation in the interactive explorer", color="#274c67", fontcolor="#274c67", penwidth="1.4"];
