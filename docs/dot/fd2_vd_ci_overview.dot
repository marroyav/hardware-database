digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#071421",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Cryogenic Instrumentation · Overview",
    labelloc="t",
    labeljust="l",
    fontname="Avenir Next",
    fontsize=26,
    fontcolor="#edf8ff"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#6ecbe8", fontcolor="#bdefff"];

  fd2_vd_ci [label="FD2-VD Cryogenic Instrumentation", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci", target="_top", tooltip="Open FD2-VD Cryogenic Instrumentation in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#08243a", color="#58c7e8", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="2.0"];

  subgraph cluster_fd2_vd_ci_purity_monitors {
    label="Purity Monitors";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_ci.purity_monitors";
    target="_top";
    tooltip="Open Purity Monitors in the interactive explorer";
    fd2_vd_ci_prm_array [label="Purity Monitor Array", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.prm_array", target="_top", tooltip="Open Purity Monitor Array in the interactive explorer", shape="ellipse", style="filled", fillcolor="#ffe0e4", color="#bf5267", fontcolor="#4b1622"];
  }

  subgraph cluster_fd2_vd_ci_tms {
    label="Temperature Monitoring System";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_ci.tms";
    target="_top";
    tooltip="Open Temperature Monitoring System in the interactive explorer";
    fd2_vd_ci_temperature_monitoring_system [label="Temperature Monitoring System", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.temperature_monitoring_system", target="_top", tooltip="Open Temperature Monitoring System in the interactive explorer", shape="ellipse", style="filled", fillcolor="#ffe0e4", color="#bf5267", fontcolor="#4b1622"];
  }

  fd2_vd_ci -> fd2_vd_ci_temperature_monitoring_system [URL="../explorer.html#object=relation%3A1", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4"];
  fd2_vd_ci -> fd2_vd_ci_prm_array [URL="../explorer.html#object=relation%3A2", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4"];
