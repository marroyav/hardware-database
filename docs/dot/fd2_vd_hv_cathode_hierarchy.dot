digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#f6f1e8",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD HV Cathode · Hierarchy",
    labelloc="t",
    labeljust="l",
    fontname="Iowan Old Style",
    fontsize=26,
    fontcolor="#183247"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#33536a", fontcolor="#33536a"];

  fd2_vd_hv_cathode [label="FD2-VD HV Cathode", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#183247", color="#183247", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="1.5"];

  subgraph cluster_fd2_vd_hv_cathode_cathode_interconnect {
    label="Cathode Interconnect";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_cathode_interconnect_cable [label="Cathode Interconnect", fontname="Avenir Next", shape="hexagon", style="filled", fillcolor="#fff0cc", color="#a56b17", fontcolor="#4f370c"];
  }

  subgraph cluster_fd2_vd_hv_cathode_cathode_plane {
    label="Cathode Plane";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_cathode_plane_assembly [label="Cathode Plane", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_hv_cathode_copper_tape {
    label="Copper Tape Strips";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_copper_tape_strip [label="Copper Tape Strip", fontname="Avenir Next", shape="note", style="filled", fillcolor="#f0e6fa", color="#7d5bb6", fontcolor="#382451"];
  }

  subgraph cluster_fd2_vd_hv_cathode_cross_ribs {
    label="Cross Ribs";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_cross_rib [label="Cross Rib", fontname="Avenir Next", shape="note", style="filled", fillcolor="#f0e6fa", color="#7d5bb6", fontcolor="#382451"];
  }

  subgraph cluster_fd2_vd_hv_cathode_half_cathode_plane {
    label="Half Cathode Plane";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_half_cathode_plane_assembly [label="Half Cathode Plane", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_hv_cathode_half_frame {
    label="Half Frame";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_half_frame_component [label="Half Frame", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_hv_cathode_lad {
    label="Length Adjusting Device";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_lad_component [label="Length Adjusting Device", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_hv_cathode_metallic_mesh {
    label="Metallic Mesh";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_metallic_mesh_component [label="Metallic Mesh", fontname="Avenir Next", shape="note", style="filled", fillcolor="#f0e6fa", color="#7d5bb6", fontcolor="#382451"];
  }

  subgraph cluster_fd2_vd_hv_cathode_pd_xar_support {
    label="PD XAR Support";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_pd_xar_support_component [label="PD XAR Support", fontname="Avenir Next", shape="note", style="filled", fillcolor="#f0e6fa", color="#7d5bb6", fontcolor="#382451"];
  }

  subgraph cluster_fd2_vd_hv_cathode_resistive_mesh {
    label="Resistive Mesh";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_resistive_mesh_component [label="Resistive Mesh", fontname="Avenir Next", shape="note", style="filled", fillcolor="#f0e6fa", color="#7d5bb6", fontcolor="#382451"];
  }

  subgraph cluster_fd2_vd_hv_cathode_shipping {
    label="Shipping";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_shipping_box [label="Shipping Box", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_hv_cathode_tad {
    label="Top Adjusting Device";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_tad_component [label="Top Adjusting Device", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  fd2_vd_hv_cathode -> fd2_vd_hv_cathode_cathode_plane_assembly [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_cathode_plane_assembly -> fd2_vd_hv_cathode_half_cathode_plane_assembly [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="2"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_half_frame_component [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_cross_rib [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_resistive_mesh_component [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_metallic_mesh_component [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_pd_xar_support_component [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_lad_component [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_cathode_interconnect_cable [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_half_cathode_plane_assembly -> fd2_vd_hv_cathode_copper_tape_strip [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_shipping_box -> fd2_vd_hv_cathode_half_frame_component [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_hv_cathode_shipping_box -> fd2_vd_hv_cathode_tad_component [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
}
