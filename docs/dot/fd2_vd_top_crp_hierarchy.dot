digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#f6f1e8",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Top Charge Readout Planes · Hierarchy",
    labelloc="t",
    labeljust="l",
    fontname="Iowan Old Style",
    fontsize=26,
    fontcolor="#183247"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#33536a", fontcolor="#33536a"];

  fd2_vd_top_crp [label="FD2-VD Top Charge Readout Planes", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#183247", color="#183247", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="1.5"];

  subgraph cluster_fd2_vd_top_crp_adapter_boards {
    label="Adapter Boards";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_adapter_board [label="Adapter Board", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  subgraph cluster_fd2_vd_top_crp_anode_panels {
    label="CRU Anode Panels";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_cru_anode_panel [label="CRU Anode Panel", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_top_crp_bias_filtering {
    label="Cold Bias Filter Boards";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_cold_bias_filter_board [label="Cold Bias Filter Board", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  subgraph cluster_fd2_vd_top_crp_bias_cabling {
    label="Cold Bias HV Cables";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_cold_bias_hv_cable [label="Cold Bias HV Cable Bundle Jumper", fontname="Avenir Next", shape="hexagon", style="filled", fillcolor="#fff0cc", color="#a56b17", fontcolor="#4f370c"];
  }

  subgraph cluster_fd2_vd_top_crp_complete_crp {
    label="Complete CRP";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_top_crp [label="Top CRP", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_top_crp_composite_frames {
    label="Composite Frames";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_composite_frame [label="Composite Frame", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_top_crp_decoupling {
    label="Decoupling Devices";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_decoupling_device [label="Decoupling Device", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_top_crp_edge_connectors {
    label="Edge Connector Boards";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_edge_connector_board [label="Edge Connector Board", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  subgraph cluster_fd2_vd_top_crp_half_crp {
    label="Half CRP / CRU";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_cru [label="Top Half CRP / CRU", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  subgraph cluster_fd2_vd_top_crp_signal_cabling {
    label="Instrumented CRP Cables";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_cable_tray [label="CRP Cable Tray", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
    fd2_vd_top_crp_signal_cable [label="CRP Signal Cable", fontname="Avenir Next", shape="hexagon", style="filled", fillcolor="#fff0cc", color="#a56b17", fontcolor="#4f370c"];
  }

  subgraph cluster_fd2_vd_top_crp_level_meter {
    label="Level Meter";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_level_meter_active_board [label="Level Meter Active Board", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
    fd2_vd_top_crp_level_meter_assembly [label="Level Meter Assembly", fontname="Avenir Next", shape="ellipse", style="filled", fillcolor="#f7dde0", color="#a14656", fontcolor="#4a1823"];
    fd2_vd_top_crp_level_meter_drawer [label="Level Meter Drawer", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
    fd2_vd_top_crp_level_meter_internal_bundle [label="Level Meter Internal Cable Bundle", fontname="Avenir Next", shape="hexagon", style="filled", fillcolor="#fff0cc", color="#a56b17", fontcolor="#4f370c"];
    fd2_vd_top_crp_level_meter_passive_board [label="Level Meter Passive Board", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#e4efe0", color="#5d7f48", fontcolor="#18311a"];
  }

  subgraph cluster_fd2_vd_top_crp_pcb_segments {
    label="PCB Anode Segments";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_pcb_anode_segment [label="PCB Anode Segment", fontname="Avenir Next", shape="note", style="filled", fillcolor="#f0e6fa", color="#7d5bb6", fontcolor="#382451"];
  }

  subgraph cluster_fd2_vd_top_crp_spacers {
    label="PEEK Spacers";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_peek_spacer [label="PEEK Spacer", fontname="Avenir Next", shape="note", style="filled", fillcolor="#f0e6fa", color="#7d5bb6", fontcolor="#382451"];
  }

  subgraph cluster_fd2_vd_top_crp_shipping {
    label="Shipping";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_top_crp_shipping_box [label="Shipping Box", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
    fd2_vd_top_crp_shipping_container [label="Shipping Container", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  fd2_vd_top_crp -> fd2_vd_top_crp_top_crp [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_top_crp -> fd2_vd_top_crp_cru [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="2"];
  fd2_vd_top_crp_cru -> fd2_vd_top_crp_composite_frame [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="1"];
  fd2_vd_top_crp_cru -> fd2_vd_top_crp_cru_anode_panel [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="2"];
  fd2_vd_top_crp_cru_anode_panel -> fd2_vd_top_crp_pcb_anode_segment [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_composite_frame -> fd2_vd_top_crp_peek_spacer [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="61"];
  fd2_vd_top_crp_cru -> fd2_vd_top_crp_adapter_board [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="12"];
  fd2_vd_top_crp_cru -> fd2_vd_top_crp_edge_connector_board [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="24"];
  fd2_vd_top_crp_cru -> fd2_vd_top_crp_cold_bias_filter_board [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_top_crp -> fd2_vd_top_crp_cold_bias_hv_cable [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="1"];
  fd2_vd_top_crp_top_crp -> fd2_vd_top_crp_decoupling_device [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_top_crp -> fd2_vd_top_crp_level_meter_assembly [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_level_meter_assembly -> fd2_vd_top_crp_level_meter_internal_bundle [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_level_meter_drawer -> fd2_vd_top_crp_level_meter_active_board [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_level_meter_drawer -> fd2_vd_top_crp_level_meter_passive_board [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_cable_tray -> fd2_vd_top_crp_signal_cable [color="#274c67", fontcolor="#274c67", penwidth="1.4", label="bundle of 12"];
  fd2_vd_top_crp_shipping_container -> fd2_vd_top_crp_shipping_box [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
  fd2_vd_top_crp_shipping_box -> fd2_vd_top_crp_cru [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
}
