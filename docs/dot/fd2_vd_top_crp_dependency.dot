digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#071421",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Top Charge Readout Planes · Dependencies",
    labelloc="t",
    labeljust="l",
    fontname="Avenir Next",
    fontsize=26,
    fontcolor="#edf8ff"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#6ecbe8", fontcolor="#bdefff"];

  fd2_vd_top_crp [label="FD2-VD Top Charge Readout Planes", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_top_crp", target="_top", tooltip="Open FD2-VD Top Charge Readout Planes in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#08243a", color="#58c7e8", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="2.0"];

  subgraph cluster_fd2_vd_top_crp_adapter_boards {
    label="Adapter Boards";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_top_crp.adapter_boards";
    target="_top";
    tooltip="Open Adapter Boards in the interactive explorer";
    fd2_vd_top_crp_adapter_board [label="Adapter Board", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_top_crp.adapter_board", target="_top", tooltip="Open Adapter Board in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  }

  subgraph cluster_fd2_vd_top_crp_bias_filtering {
    label="Cold Bias Filter Boards";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_top_crp.bias_filtering";
    target="_top";
    tooltip="Open Cold Bias Filter Boards in the interactive explorer";
    fd2_vd_top_crp_cold_bias_filter_board [label="Cold Bias Filter Board", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_top_crp.cold_bias_filter_board", target="_top", tooltip="Open Cold Bias Filter Board in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  }

  subgraph cluster_fd2_vd_top_crp_bias_cabling {
