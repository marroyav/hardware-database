digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#071421",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Top Vertical Drift CRP Electronics · Dependencies",
    labelloc="t",
    labeljust="l",
    fontname="Avenir Next",
    fontsize=26,
    fontcolor="#edf8ff"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#6ecbe8", fontcolor="#bdefff"];

  fd2_vd_tde [label="FD2-VD Top Vertical Drift CRP Electronics", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde", target="_top", tooltip="Open FD2-VD Top Vertical Drift CRP Electronics in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#08243a", color="#58c7e8", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="2.0"];

  subgraph cluster_fd2_vd_tde_analog_electronics {
    label="Analog Electronics";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_tde.analog_electronics";
    target="_top";
    tooltip="Open Analog Electronics in the interactive explorer";
    fd2_vd_tde_feb_analog_card [label="FEB Analog Card", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.feb_analog_card", target="_top", tooltip="Open FEB Analog Card in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  }

  subgraph cluster_fd2_vd_tde_digital_electronics {
    label="Digital Electronics";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_tde.digital_electronics";
    target="_top";
    tooltip="Open Digital Electronics in the interactive explorer";
    fd2_vd_tde_amc_digitization_card [label="AMC Digitization Card", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.amc_digitization_card", target="_top", tooltip="Open AMC Digitization Card in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
    fd2_vd_tde_wr_mch_timing_end_node [label="WR-MCH Timing End-Node", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.wr_mch_timing_end_node", target="_top", tooltip="Open WR-MCH Timing End-Node in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  }

  subgraph cluster_fd2_vd_tde_sgft_chimney {
    label="SGFT Chimney";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_tde.sgft_chimney";
    target="_top";
    tooltip="Open SGFT Chimney in the interactive explorer";
    fd2_vd_tde_cold_flange [label="Cold Flange", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.cold_flange", target="_top", tooltip="Open Cold Flange in the interactive explorer", shape="parallelogram", style="filled", fillcolor="#f4e5c4", color="#b48225", fontcolor="#4b3307"];
    fd2_vd_tde_warm_flange [label="Warm Flange", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.warm_flange", target="_top", tooltip="Open Warm Flange in the interactive explorer", shape="parallelogram", style="filled", fillcolor="#f4e5c4", color="#b48225", fontcolor="#4b3307"];
  }

  subgraph cluster_fd2_vd_tde_ancillary_systems {
    label="TDE Ancillary Systems";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_tde.ancillary_systems";
    target="_top";
    tooltip="Open TDE Ancillary Systems in the interactive explorer";
    fd2_vd_tde_calibration_unit [label="Calibration Unit", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.calibration_unit", target="_top", tooltip="Open Calibration Unit in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
    fd2_vd_tde_filter_fanout_box [label="LV Filter And Fanout", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.filter_fanout_box", target="_top", tooltip="Open LV Filter And Fanout in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
    fd2_vd_tde_lv_ps [label="Low-Voltage Power Supply", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.lv_ps", target="_top", tooltip="Open Low-Voltage Power Supply in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  }

  subgraph cluster_fd2_vd_tde_timing_distribution {
    label="Timing Distribution";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_tde.timing_distribution";
    target="_top";
    tooltip="Open Timing Distribution in the interactive explorer";
    fd2_vd_tde_timing_fiber [label="WR Fiber", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.timing_fiber", target="_top", tooltip="Open WR Fiber in the interactive explorer", shape="octagon", style="filled", fillcolor="#ffe3bf", color="#c56c2f", fontcolor="#4a260b"];
    fd2_vd_tde_wr_switch [label="White Rabbit Switch", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_tde.wr_switch", target="_top", tooltip="Open White Rabbit Switch in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
  }

  fd2_vd_tde_cold_flange -> fd2_vd_tde_feb_analog_card [URL="../explorer.html#object=relation%3A61", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_tde_warm_flange -> fd2_vd_tde_amc_digitization_card [URL="../explorer.html#object=relation%3A62", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_tde_lv_ps -> fd2_vd_tde_filter_fanout_box [URL="../explorer.html#object=relation%3A65", target="_top", tooltip="Open powers relation in the interactive explorer", color="#df704e", fontcolor="#ffb39e", style="dashed", penwidth="1.2", label="power"];
