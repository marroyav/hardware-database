  fd2_vd_tde_calibration_unit -> fd2_vd_tde_warm_flange [URL="../explorer.html#object=relation%3A71", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_tde_timing_fiber -> fd2_vd_tde_wr_switch [URL="../explorer.html#object=relation%3A77", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_tde_timing_fiber -> fd2_vd_tde_wr_mch_timing_end_node [URL="../explorer.html#object=relation%3A78", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_tde_wr_switch -> fd2_vd_tde_wr_mch_timing_end_node [URL="../explorer.html#object=relation%3A79", target="_top", tooltip="Open timed by relation in the interactive explorer", color="#62c7bc", fontcolor="#a9eee8", style="dashed", penwidth="1.2", label="timing"];
}
