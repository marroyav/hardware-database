digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#f6f1e8",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD HV Cathode · Overview",
    labelloc="t",
    labeljust="l",
    fontname="Iowan Old Style",
    fontsize=26,
    fontcolor="#183247"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#33536a", fontcolor="#33536a"];

  fd2_vd_hv_cathode [label="FD2-VD HV Cathode", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#183247", color="#183247", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="1.5"];

  subgraph cluster_fd2_vd_hv_cathode_cathode_plane {
    label="Cathode Plane";
    style="rounded,filled";
    color="#c7b8a1";
    fillcolor="#fbf7f0";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#5a4634";
    fd2_vd_hv_cathode_cathode_plane_assembly [label="Cathode Plane", fontname="Avenir Next", shape="box", style="rounded,filled", fillcolor="#dfe9f2", color="#53718a", fontcolor="#173140"];
  }

  fd2_vd_hv_cathode -> fd2_vd_hv_cathode_cathode_plane_assembly [color="#274c67", fontcolor="#274c67", penwidth="1.4"];
}
