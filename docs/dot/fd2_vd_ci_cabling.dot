digraph HardwareModel {
  graph [
    rankdir=LR,
    splines=true,
    overlap=false,
    newrank=true,
    compound=true,
    bgcolor="#071421",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.8",
    label="FD2-VD Cryogenic Instrumentation · Cabling",
    labelloc="t",
    labeljust="l",
    fontname="Avenir Next",
    fontsize=26,
    fontcolor="#edf8ff"
  ];
  node [fontname="Avenir Next", fontsize=12, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="Avenir Next", fontsize=10, arrowsize=0.8, penwidth=1.2, color="#6ecbe8", fontcolor="#bdefff"];

  fd2_vd_ci [label="FD2-VD Cryogenic Instrumentation", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci", target="_top", tooltip="Open FD2-VD Cryogenic Instrumentation in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#08243a", color="#58c7e8", fontcolor="#ffffff", fontsize="16", margin="0.24,0.16", penwidth="2.0"];

  subgraph cluster_fd2_vd_ci_tms {
    label="Temperature Monitoring System";
    style="rounded,filled";
    color="#456174";
    fillcolor="#0f2434";
    penwidth=1.1;
    fontname="Avenir Next";
    fontsize=13;
    fontcolor="#e8f7ff";
    URL="../explorer.html#object=fd2_vd_ci.tms";
    target="_top";
    tooltip="Open Temperature Monitoring System in the interactive explorer";
    fd2_vd_ci_cold_cable [label="Cold Cable", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.cold_cable", target="_top", tooltip="Open Cold Cable in the interactive explorer", shape="hexagon", style="filled", fillcolor="#fff0bf", color="#d69a2d", fontcolor="#3f2a08"];
    fd2_vd_ci_gas_array [label="Gas Array", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.gas_array", target="_top", tooltip="Open Gas Array in the interactive explorer", shape="ellipse", style="filled", fillcolor="#ffe0e4", color="#bf5267", fontcolor="#4b1622"];
    fd2_vd_ci_rtd [label="RTD", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.rtd", target="_top", tooltip="Open RTD in the interactive explorer", shape="ellipse", style="filled", fillcolor="#ffe0e4", color="#bf5267", fontcolor="#4b1622"];
    fd2_vd_ci_t2_bundle [label="T2 Cable Bundle", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.t2_bundle", target="_top", tooltip="Open T2 Cable Bundle in the interactive explorer", shape="hexagon", style="filled", fillcolor="#fff0bf", color="#d69a2d", fontcolor="#3f2a08"];
    fd2_vd_ci_t4_bundle [label="T4 Cable Bundle", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.t4_bundle", target="_top", tooltip="Open T4 Cable Bundle in the interactive explorer", shape="hexagon", style="filled", fillcolor="#fff0bf", color="#d69a2d", fontcolor="#3f2a08"];
    fd2_vd_ci_t6_bundle [label="T6 Cable Bundle", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.t6_bundle", target="_top", tooltip="Open T6 Cable Bundle in the interactive explorer", shape="hexagon", style="filled", fillcolor="#fff0bf", color="#d69a2d", fontcolor="#3f2a08"];
    fd2_vd_ci_tms_card [label="TMS Card", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.tms_card", target="_top", tooltip="Open TMS Card in the interactive explorer", shape="box", style="rounded,filled", fillcolor="#d9f0e5", color="#3a8a68", fontcolor="#0b2f25"];
    fd2_vd_ci_tms_flange [label="TMS Flange", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.tms_flange", target="_top", tooltip="Open TMS Flange in the interactive explorer", shape="parallelogram", style="filled", fillcolor="#f4e5c4", color="#b48225", fontcolor="#4b3307"];
    fd2_vd_ci_warm_cable [label="Warm Cable", fontname="Avenir Next", URL="../explorer.html#object=fd2_vd_ci.warm_cable", target="_top", tooltip="Open Warm Cable in the interactive explorer", shape="hexagon", style="filled", fillcolor="#fff0bf", color="#d69a2d", fontcolor="#3f2a08"];
  }

  fd2_vd_ci_gas_array -> fd2_vd_ci_t6_bundle [URL="../explorer.html#object=relation%3A4", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4", label="3"];
  fd2_vd_ci_t6_bundle -> fd2_vd_ci_cold_cable [URL="../explorer.html#object=relation%3A5", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4"];
  fd2_vd_ci_t4_bundle -> fd2_vd_ci_cold_cable [URL="../explorer.html#object=relation%3A6", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4"];
  fd2_vd_ci_t2_bundle -> fd2_vd_ci_cold_cable [URL="../explorer.html#object=relation%3A7", target="_top", tooltip="Open contains relation in the interactive explorer", color="#6ecbe8", fontcolor="#bdefff", penwidth="1.4"];
  fd2_vd_ci_cold_cable -> fd2_vd_ci_rtd [URL="../explorer.html#object=relation%3A8", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_ci_t6_bundle -> fd2_vd_ci_tms_flange [URL="../explorer.html#object=relation%3A9", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_ci_t4_bundle -> fd2_vd_ci_tms_flange [URL="../explorer.html#object=relation%3A10", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_ci_t2_bundle -> fd2_vd_ci_tms_flange [URL="../explorer.html#object=relation%3A11", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_ci_warm_cable -> fd2_vd_ci_tms_flange [URL="../explorer.html#object=relation%3A12", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
  fd2_vd_ci_warm_cable -> fd2_vd_ci_tms_card [URL="../explorer.html#object=relation%3A13", target="_top", tooltip="Open connects to relation in the interactive explorer", color="#e3a63b", fontcolor="#f4c86f", style="dashed", penwidth="1.2", label="connects"];
}
