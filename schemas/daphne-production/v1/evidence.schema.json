{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunedaq.org/schemas/daphne-production/v1/evidence.schema.json",
  "title": "DAPHNE append-only production evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "operation_id", "asset_id", "event_type", "outcome", "station_id", "operator", "observed_at", "data"],
  "properties": {
    "contract": {"const": "daphne.evidence"},
    "version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "som_uuid": {"type": ["string", "null"], "format": "uuid"},
    "event_type": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["recorded", "passed", "failed"]},
    "station_id": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_uri": {"type": ["string", "null"]},
    "evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "data": {"type": "object"}
  }
}
